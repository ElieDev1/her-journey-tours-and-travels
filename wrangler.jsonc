{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "her-journey-tours-and-travels",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs first for the API, uploaded media and pages that
    // need server-side SEO metadata. Everything else is served directly.
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/tours",
      "/tours/*",
      "/sitemap.xml",
      "/robots.txt",
      "/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "her-journey-db",
      "database_id": "662067b4-e048-454b-9a4e-fad160d711d3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "her-journey-media"
    }
  ],
  // Expire unpaid bookings and release their seats every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    // Leave empty to use the address the site is served from. Set it to your
    // custom domain (e.g. "https://herjourneytours.rw") once you have one.
    "PUBLIC_SITE_URL": ""
  }
}
