{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "her-journey-tours-and-travels",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request so it can redirect www to the apex
    // domain, serve verification files and render SEO metadata. It hands
    // everything else to the static assets.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "her-journey-db",
      "database_id": "662067b4-e048-454b-9a4e-fad160d711d3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "her-journey-media"
    }
  ],
  // Expire unpaid bookings and release their seats every 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Transactional email (password resets, booking confirmations) through
  // Cloudflare Email Sending. herjourney.rw must be onboarded under
  // Email Service > Email Sending; see README "Email".
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@herjourney.rw"]
    }
  ],
  "vars": {
    "APP_ENV": "production",
    // Canonical origin for SEO tags, the sitemap and links in emails.
    "PUBLIC_SITE_URL": "https://herjourney.rw",
    "EMAIL_FROM": "noreply@herjourney.rw",
    "EMAIL_FROM_NAME": "Her Journey Tours and Travels",
    // Public OAuth client id. GOOGLE_CLIENT_SECRET is a Worker secret.
    "GOOGLE_CLIENT_ID": "785941978620-bv1tb1m35bvl5uf8k3hndkl8j036tgle.apps.googleusercontent.com"
  }
}
